# Copy to .env.local and fill in. .env.local is gitignored.

# Supabase — project ref kjrykbcbsugkaxhsahex ("portfolio-rag", eu-west-3)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
# Server-side only. Bypasses RLS — never ship to the browser.
# Dashboard > Project Settings > API Keys
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API (embeddings + message generation)
ANTHROPIC_API_KEY=

# Shared secret for the x-api-key header on /api/chat and /api/seed-vectors
RAG_API_KEY=
